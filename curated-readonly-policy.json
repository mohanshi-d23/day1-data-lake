{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyCuratedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mohanshi-mini-datalake-2026",
      "Condition": {
        "StringLike": { "s3:prefix": ["curated", "curated/*"] }
      }
    },
    {
      "Sid": "ReadOnlyCuratedObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mohanshi-mini-datalake-2026/curated/*"
    }
  ]
}